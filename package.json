{
    "name": "when-then",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "prepare": "vp config && svelte-kit sync && vp run i18n:compile || echo ''",
        "check": "svelte-kit sync && vp check && vp run check:svelte",
        "check:svelte": "svelte-kit sync && vp run i18n:compile && svelte-check --tsconfig ./tsconfig.json && tsc -p ./src/service-worker/tsconfig.json",
        "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:reset": "supabase db reset",
        "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts && vp fmt src/lib/database.types.ts",
        "db:pull": "supabase db dump --linked --data-only --schema public -f supabase/.temp/prod-data.sql && psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f supabase/.temp/prod-data.sql",
        "test": "vp test && vp run test:e2e",
        "test:unit": "vp test",
        "test:e2e": "playwright test",
        "test:db": "supabase test db",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@lucide/svelte": "^1.61.0",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.29.1",
        "@internationalized/date": "^3.12.4",
        "@playwright/test": "^1.64.1",
        "@storybook/addon-a11y": "11.0.0-alpha.7",
        "@storybook/addon-docs": "11.0.0-alpha.7",
        "@storybook/svelte": "11.0.0-alpha.7",
        "@storybook/sveltekit": "11.0.0-alpha.7",
        "@sveltejs/adapter-vercel": "^7.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitest/browser-playwright": "catalog:",
        "bits-ui": "^2.20.0",
        "cn": "^0.5.0",
        "playwright": "^1.64.1",
        "shadcn-svelte": "^1.7.0",
        "storybook": "11.0.0-alpha.7",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-svelte": "^2.2.1"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24"
    }
}
