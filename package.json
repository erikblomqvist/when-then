{
	"name": "when-then",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "vp check && vp run check:svelte",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "11.0.0-alpha.7",
		"@storybook/addon-docs": "11.0.0-alpha.7",
		"@storybook/svelte": "11.0.0-alpha.7",
		"@storybook/sveltekit": "11.0.0-alpha.7",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"storybook": "11.0.0-alpha.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.22.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24"
	}
}
