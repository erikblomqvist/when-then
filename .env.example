# Copy to .env.local for local development. Production and preview values live in Vercel
# (Project → Settings → Environment Variables), never on a laptop.
#
# `supabase start` prints the local stack's URL and keys; paste them here.

# Server only (secret key bypasses RLS; used by src/lib/server/supabase.ts)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Sent to the browser (SvelteKit exposes PUBLIC_* only). Same URL and the publishable key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth for admin sign-in on the *local* Supabase stack (supabase/config.toml reads
# these). Optional: anonymous sign-in works without them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
